rules_version = '2';

// A família é formada por quem entra primeiro com a conta Google: uma Luiza e
// até dois pais, gravados em config/familia. Depois que as vagas enchem, o
// documento não aceita mais ninguém e quem não está nele não lê nem escreve nada.
service cloud.firestore {
  match /databases/{database}/documents {
    function config() {
      return get(/databases/$(database)/documents/config/familia).data;
    }
    function temConfig() {
      return exists(/databases/$(database)/documents/config/familia);
    }
    function filha() {
      return request.auth != null && temConfig() && config().filha.get('uid', '') == request.auth.uid;
    }
    function pais() {
      return request.auth != null && temConfig() && request.auth.uid in config().pais;
    }
    function familia() { return filha() || pais(); }

    match /config/familia {
      // Quem acabou de entrar precisa ver quais vagas ainda estão livres.
      allow read: if request.auth != null;

      // Primeira pessoa a entrar cria o documento já ocupando a sua vaga.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['filha', 'pais'])
        && (
          (request.resource.data.filha.keys().hasOnly(['uid', 'nome'])
            && request.resource.data.filha.uid == request.auth.uid
            && request.resource.data.filha.nome is string
            && request.resource.data.pais.size() == 0)
          ||
          (request.resource.data.filha.size() == 0
            && request.resource.data.pais.keys().hasOnly([request.auth.uid])
            && request.resource.data.pais[request.auth.uid] is string)
        );

      // Depois, cada pessoa só pode acrescentar a si mesma numa vaga livre.
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['filha', 'pais'])
        && !(request.auth.uid in resource.data.pais)
        && resource.data.filha.get('uid', '') != request.auth.uid
        && (
          (resource.data.filha.size() == 0
            && request.resource.data.filha.keys().hasOnly(['uid', 'nome'])
            && request.resource.data.filha.uid == request.auth.uid
            && request.resource.data.filha.nome is string
            && request.resource.data.pais == resource.data.pais)
          ||
          (request.resource.data.filha == resource.data.filha
            && resource.data.pais.size() < 2
            && request.resource.data.pais.diff(resource.data.pais).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.pais[request.auth.uid] is string)
        );
    }

    // Só os pais criam e removem tarefas.
    match /tarefas/{id} {
      allow read: if familia();
      allow write: if pais();
    }

    // A Luiza marca a tarefa; só os pais aprovam ou mandam refazer (campo revisao).
    match /conclusoes/{id} {
      allow read, delete: if familia();
      allow create, update: if pais() || (filha() && !('revisao' in request.resource.data));
    }

    // Valor da mesada e do bônus semanal.
    match /config/mesada {
      allow read: if familia();
      allow write: if pais()
        && request.resource.data.keys().hasOnly(['base', 'bonus'])
        && request.resource.data.base is number && request.resource.data.base >= 0
        && request.resource.data.bonus is number && request.resource.data.bonus >= 0;
    }

    // A Luiza explica por que não fez a tarefa; os pais aprovam ou recusam.
    match /justificativas/{id} {
      allow read: if familia();
      allow create: if filha()
        && request.resource.data.status == 'pendente'
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() > 0
        && request.resource.data.motivo.size() <= 500;
      // Ela só pode reenviar (ou cancelar) enquanto os pais não aprovaram.
      allow update: if (filha() && resource.data.status != 'aprovada'
          && request.resource.data.status == 'pendente'
          && request.resource.data.motivo is string
          && request.resource.data.motivo.size() <= 500)
        || (pais() && request.resource.data.status in ['aprovada', 'recusada']);
      allow delete: if filha() && resource.data.status != 'aprovada';
    }

    // Fotos pequenas (o app já comprime antes de enviar).
    match /fotos/{id} {
      allow read, delete: if familia();
      allow create: if familia()
        && request.resource.data.imagem is string
        && request.resource.data.imagem.size() < 900000;
    }
  }
}
